# Copy this file to .env for local development.
# In Railway, set these as Variables on the service instead of a file.

# Provided automatically by Railway's PostgreSQL plugin as DATABASE_URL.
# For local dev, point at a local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_billing

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-value

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.up.railway.app

# Local storage path for uploaded branding assets during development.
# In production, swap the storage service for S3-compatible object storage.
UPLOAD_DIR=./uploads
